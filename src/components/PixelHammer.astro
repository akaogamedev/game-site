---
// 「開発中」セクションの見出しに使うトンカチのピクセルアートSVG(16x16グリッド)
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 16 16"
  shape-rendering="crispEdges"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <!-- ヘッド -->
  <rect x="2" y="2" width="12" height="5" fill="#16161c"></rect>
  <rect x="3" y="3" width="10" height="2" fill="#c8ccc4"></rect>
  <rect x="3" y="5" width="10" height="1" fill="#8e918a"></rect>
  <!-- 首 -->
  <rect x="6" y="7" width="4" height="2" fill="#16161c"></rect>
  <!-- 柄 -->
  <rect x="7" y="9" width="2" height="6" fill="#b5854e"></rect>
  <rect x="7" y="9" width="1" height="6" fill="#8a5f33"></rect>
</svg>
