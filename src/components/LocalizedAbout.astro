---
import { getCollection } from 'astro:content';
import type { Locale } from '../i18n/config';
import { uiCopy } from '../i18n/ui';
import { statusCopy, characterCopy } from '../i18n/about-status';
import BaseLayout from '../layouts/BaseLayout.astro';
import PixelChara from './PixelChara.astro';
import PixelOnaga from './PixelOnaga.astro';
import PixelStatusIcon from './PixelStatusIcon.astro';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const copy = uiCopy[locale].aboutPage;
const home = uiCopy[locale].home;
const labels = statusCopy[locale];
const character = characterCopy[locale];
const names = [uiCopy[locale].game.akao, copy.partnerName];
const published = (await getCollection('games')).filter(game => game.data.unityroomNo).length;
---
<BaseLayout title={copy.title} locale={locale}>
  <section class="profile-stage">
    <div class="profile-screen" data-party-screen>
      <header class="screen-heading"><h1>{copy.title}</h1><span aria-hidden="true">◆ ◆</span></header>
      <div class="profile-grid">
        <section class="party-window window" aria-labelledby="party-heading">
          <h2 class="window-label" id="party-heading">{labels.party}</h2>
          <div class="party-members" role="group" aria-label={labels.select}>
            {names.map((name, i) => (
              <button class="party-member" type="button" data-member={i} aria-pressed={i === 0} aria-controls={`member-status-${i} member-message-${i}`}>
                <span class="member-cursor" aria-hidden="true">▼</span>
                <span class="member-reaction" aria-hidden="true">{i === 0 ? <PixelStatusIcon kind="idea" size={32}/> : <span>!</span>}</span>
                <span class="member-sprite" aria-hidden="true">{i === 0 ? <PixelChara size={104}/> : <PixelOnaga size={100}/>}</span>
                <span class="member-ground" aria-hidden="true"></span>
                <span class="member-name">{name}</span>
              </button>
            ))}
          </div>
          <p class="selection-hint"><span aria-hidden="true">← →</span> {labels.select}</p>
        </section>

        <section class="stats-window window" aria-labelledby="stats-heading" aria-live="polite" aria-atomic="true">
          <h2 class="window-label" id="stats-heading">{labels.status}</h2>
          <div id="member-status-0" data-member-content="0">
            <dl class="stats">
              <div class="name-row"><dt>{labels.name}</dt><dd>{names[0]}</dd></div>
              <div><dt>{character.job}</dt><dd class="icon-value"><span class="stat-icon"><PixelStatusIcon kind="gamepad"/></span><span>{character.jobs[0]}</span></dd></div>
              <div><dt>{character.skill}</dt><dd class="icon-value"><span class="stat-icon"><PixelStatusIcon kind="idea"/></span><span>{character.skills[0]}</span></dd></div>
              <div><dt>{character.companion}</dt><dd><button class="companion-command" type="button" data-companion="1" aria-controls="member-status-1 member-message-1"><span class="stat-icon"><PixelOnaga size={30}/></span><span>{names[1]}</span><span class="companion-arrow" aria-hidden="true">▶</span></button></dd></div>
            </dl>
          </div>
          <div id="member-status-1" data-member-content="1" hidden>
            <dl class="stats">
              <div class="name-row"><dt>{labels.name}</dt><dd>{names[1]}</dd></div>
              <div><dt>{character.job}</dt><dd class="icon-value"><span class="stat-icon"><PixelStatusIcon kind="speech"/></span><span>{character.jobs[1]}</span></dd></div>
              <div><dt>{character.skill}</dt><dd class="icon-value"><span class="stat-icon"><PixelStatusIcon kind="question"/></span><span>{character.skills[1]}</span></dd></div>
              <div><dt>{character.companion}</dt><dd><button class="companion-command" type="button" data-companion="0" aria-controls="member-status-0 member-message-0"><span class="stat-icon"><PixelChara size={25}/></span><span>{names[0]}</span><span class="companion-arrow" aria-hidden="true">▶</span></button></dd></div>
            </dl>
          </div>
        </section>

        <section class="message-window window" aria-labelledby="message-heading">
          <h2 class="window-label" id="message-heading" data-profile-heading={copy.title} data-partner-heading={copy.partnerHeading}>{copy.title}</h2>
          <div id="member-message-0" data-member-content="0"><p>{character.descriptions[0]}</p></div>
          <div id="member-message-1" data-member-content="1" hidden><p>{character.descriptions[1]}</p></div>
        </section>
      </div>
      <section class="quest-window" aria-labelledby="quest-heading">
        <h2 id="quest-heading"><PixelStatusIcon kind="scroll" size={40}/><span>{character.quest}</span></h2>
        <div class="quest-progress">
          <div class="progress-heading"><span id="project-progress-label">{home.unityroomTitle}</span><strong>{published}<span> / 100</span></strong></div>
          <div class="project-progress" role="progressbar" aria-labelledby="project-progress-label" aria-valuemin="0" aria-valuemax="100" aria-valuenow={Math.min(published, 100)}><span style={`--progress: ${Math.min(published, 100)}%`}></span></div>
        </div>
      </section>
      <div class="secondary-commands">
        <details>
          <summary>{copy.linksHeading}</summary>
          <ul class="link-list">
            <li><a href="https://x.com/akaogame0124" target="_blank" rel="noopener">X · @akaogame0124</a></li>
            <li><a href="https://unityroom.com/users/pu8lzf2nc9ht5o1r46sg" target="_blank" rel="noopener">unityroom · {copy.unityroomProfile}</a></li>
            <li><a href="https://apps.apple.com/developer/atsuki-murayama/id1721887609" target="_blank" rel="noopener">App Store · {copy.appStoreDeveloper}</a></li>
          </ul>
        </details>
        <details>
          <summary>{copy.contactHeading}</summary>
          <p>{copy.contactBefore} <a href="https://x.com/akaogame0124" target="_blank" rel="noopener">X (@akaogame0124)</a> {copy.contactMiddle} <a href="mailto:contact@akao-game.com">contact@akao-game.com</a>{copy.contactAfter}</p>
        </details>
      </div>
      <noscript><p class="no-script-partner"><strong>{copy.partnerName}</strong> — {character.descriptions[1]}</p></noscript>
    </div>
  </section>
</BaseLayout>

<script>
  function initializeParty() {
    document.querySelectorAll<HTMLElement>('[data-party-screen]').forEach(root => {
      if (root.dataset.ready) return;
      root.dataset.ready = 'true';
      const members = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-member]'));
      const content = Array.from(root.querySelectorAll<HTMLElement>('[data-member-content]'));
      const reactions = new Map<HTMLElement, Animation>();
      function select(index: number) {
        members.forEach((member, i) => member.setAttribute('aria-pressed', String(i === index)));
        content.forEach(panel => { panel.hidden = panel.dataset.memberContent !== String(index); });
        const heading = root.querySelector<HTMLElement>('#message-heading')!;
        heading.textContent = heading.getAttribute(index === 0 ? 'data-profile-heading' : 'data-partner-heading');
        reactions.forEach(animation => animation.cancel());
        reactions.clear();
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          const reaction = members[index].querySelector<HTMLElement>('.member-reaction')!;
          const animation = reaction.animate([
            { opacity: 0, transform: 'translateY(6px) scale(.7)', offset: 0 },
            { opacity: 1, transform: 'translateY(-4px) scale(1.1)', offset: .2 },
            { opacity: 1, transform: 'translateY(-4px) scale(1)', offset: .75 },
            { opacity: 0, transform: 'translateY(-12px) scale(1)', offset: 1 },
          ], { duration: 650, easing: 'steps(5, end)' });
          reactions.set(reaction, animation);
        }
      }
      members.forEach((member, index) => {
        member.addEventListener('click', () => select(index));
        member.addEventListener('keydown', event => {
          let next: number;
          if (['ArrowRight', 'ArrowDown'].includes(event.key)) next = (index + 1) % members.length;
          else if (['ArrowLeft', 'ArrowUp'].includes(event.key)) next = (index + members.length - 1) % members.length;
          else if (event.key === 'Home') next = 0;
          else if (event.key === 'End') next = members.length - 1;
          else return;
          event.preventDefault();
          select(next);
          members[next].focus();
        });
      });
      root.querySelectorAll<HTMLButtonElement>('[data-companion]').forEach(button => {
        button.addEventListener('click', () => {
          const index = Number(button.dataset.companion);
          select(index);
          members[index].focus({ preventScroll: true });
        });
      });
    });
  }
  initializeParty();
  document.addEventListener('astro:page-load', initializeParty);
</script>

<style>
  .profile-stage { padding: 40px 24px 64px; background: var(--sky-now); min-height: 75vh; }
  .profile-screen { --window: #203c72; --window-muted: #b9cbea; max-width: 1040px; margin: auto; }
  .screen-heading { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 24px; }
  .screen-heading h1 { margin: 0; font-size: clamp(22px, 3vw, 30px); color: var(--cream); text-shadow: 2px 2px 0 var(--ink), -1px -1px 0 var(--ink), 1px -1px 0 var(--ink), -1px 1px 0 var(--ink); }
  .screen-heading > span { color: var(--yellow); text-shadow: 2px 2px var(--ink); letter-spacing: 5px; }
  .profile-grid { display: grid; grid-template-columns: minmax(0, .95fr) minmax(0, 1.15fr); gap: 20px; }
  .window { position: relative; background: var(--window); color: var(--cream); border: 3px solid var(--cream); outline: 3px solid var(--ink); box-shadow: 6px 6px 0 var(--ink), inset 0 0 0 3px #526e9f; padding: 24px; min-width: 0; }
  .window-label { position: absolute; top: -17px; left: 20px; max-width: calc(100% - 40px); padding: 0 10px; margin: 0; background: var(--window); font-size: 16px; line-height: 28px; font-weight: normal; }
  .party-window { display: flex; flex-direction: column; justify-content: center; }
  .party-window > .window-label { background: var(--yellow); color: var(--ink); border: 2px solid var(--ink); box-shadow: 2px 2px 0 var(--ink); }
  .party-members { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; padding: 4px 0; }
  .party-member { appearance: none; position: relative; display: flex; flex-direction: column; align-items: center; justify-content: end; min-width: 0; min-height: 252px; padding: 28px 4px 8px; background: none; color: inherit; font: inherit; border: 0; cursor: pointer; }
  .member-cursor { position: absolute; top: 0; font-size: 18px; line-height: 24px; color: var(--yellow); opacity: 0; transform: translateY(-6px); transition: transform 160ms steps(3, end), opacity 160ms; }
  .member-reaction { position: absolute; top: 26px; left: calc(50% + 36px); z-index: 2; display: flex; align-items: center; justify-content: center; width: 36px; height: 40px; opacity: 0; pointer-events: none; }
  .member-reaction > span { font: bold 32px/1 var(--font-pixel); color: var(--yellow); text-shadow: 2px 2px var(--ink); }
  .member-sprite { height: 148px; display: flex; align-items: end; justify-content: center; position: relative; z-index: 1; opacity: .5; transform: translateY(-8px) scale(.9); transform-origin: center bottom; transition: transform 220ms steps(4, end), opacity 180ms; }
  .member-ground { width: 112px; max-width: 100%; height: 12px; margin-top: 3px; background: #101f3f; border-bottom: 3px solid #435e8a; transform: scaleX(.85); transition: transform 220ms steps(4, end); }
  .member-name { margin-top: 18px; border-bottom: 2px solid transparent; padding: 0 5px; overflow-wrap: anywhere; }
  .party-member[aria-pressed='true'] .member-cursor { opacity: 1; transform: translateY(0); }
  .party-member[aria-pressed='true'] .member-sprite { opacity: 1; transform: translateY(3px) scale(1); }
  .party-member[aria-pressed='true'] .member-ground { transform: scaleX(1); }
  .party-member[aria-pressed='true'] .member-name { color: var(--yellow); border-bottom-color: var(--yellow); }
  .party-member:hover .member-name { color: var(--yellow); }
  .selection-hint { margin: 14px 0 0; text-align: center; color: var(--window-muted); font-size: 12px; }
  .selection-hint span { margin-right: 8px; }
  .stats-window { min-height: 310px; }
  .stats { margin: 0; }
  .stats > div { display: grid; grid-template-columns: 76px minmax(0, 1fr); gap: 12px; align-items: center; padding: 9px 0; }
  .icon-value, .companion-command { display: flex; align-items: center; gap: 12px; }
  .stat-icon { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; flex: 0 0 40px; background: #142a51; border: 2px solid #526e9f; }
  .companion-command { font: inherit; color: var(--cream); background: transparent; border: 0; padding: 2px 8px 2px 0; cursor: pointer; text-align: left; max-width: 100%; }
  .companion-command:hover { color: var(--yellow); }
  .companion-command:hover .stat-icon { border-color: var(--yellow); }
  .companion-arrow { color: var(--yellow); font-size: 10px; }
  .stats dt { color: var(--window-muted); font-size: 14px; overflow-wrap: anywhere; }
  .stats dd { margin: 0; line-height: 1.65; overflow-wrap: anywhere; }
  .stats .name-row { margin-bottom: 5px; }
  .name-row dd { font-size: 28px; color: var(--yellow); }
  .quest-window { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 24px; align-items: center; margin-top: 22px; padding: 16px 22px; background: var(--cream); border: 3px solid var(--ink); box-shadow: 3px 3px 0 var(--ink); }
  .quest-window h2 { display: flex; align-items: center; gap: 12px; margin: 0; font-size: 14px; font-weight: normal; }
  .quest-window h2 :global(svg) { flex-shrink: 0; }
  .quest-progress { min-width: 0; }
  .progress-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin: 0 0 8px; font-size: 13px; }
  .progress-heading strong { white-space: nowrap; color: var(--blue); font-weight: normal; font-size: 22px; }
  .progress-heading strong span { color: var(--ink); font-size: 14px; }
  .project-progress { padding: 3px; height: 19px; border: 2px solid var(--cream); background: #101f3f; }
  .project-progress > span { display: block; width: var(--progress); height: 100%; background: repeating-linear-gradient(90deg, var(--yellow) 0 9px, #d4b451 9px 12px); }
  .message-window { grid-column: 1 / -1; min-height: 170px; padding: 26px 28px; }
  .message-window p { margin: 0; line-height: 1.95; overflow-wrap: anywhere; }
  .message-window p + p { margin-top: 10px; }
  [data-member-content][hidden] { display: none; }
  [data-ready] [data-member-content]:not([hidden]) { animation: reveal-status 150ms steps(3, end); }
  .secondary-commands { display: flex; flex-wrap: wrap; align-items: start; gap: 12px; margin-top: 24px; }
  .secondary-commands details { background: var(--cream); color: var(--ink); border: 3px solid var(--ink); box-shadow: 3px 3px 0 var(--ink); max-width: 100%; }
  .secondary-commands summary { cursor: pointer; padding: 8px 20px; font-size: 14px; }
  .secondary-commands details[open] { flex: 1 1 360px; }
  .secondary-commands details[open] summary { border-bottom: 2px solid var(--ink); background: var(--yellow); }
  .secondary-commands p, .link-list { margin: 0; padding: 16px 20px; overflow-wrap: anywhere; font-size: 14px; }
  .link-list { list-style: none; }
  .link-list li + li { margin-top: 12px; }
  .no-script-partner { background: var(--cream); padding: 16px; }
  button:focus-visible, summary:focus-visible { outline: 3px solid var(--yellow); outline-offset: 4px; }
  summary:focus-visible, a:focus-visible { outline: 3px solid var(--blue); outline-offset: 3px; }
  @keyframes reveal-status { from { opacity: .35; } to { opacity: 1; } }
  @media(max-width: 700px) {
    .profile-stage { padding: 24px 16px 44px; }
    .profile-grid { grid-template-columns: minmax(0, 1fr); gap: 26px; }
    .window { padding: 20px; }
    .screen-heading { margin-bottom: 24px; }
    .screen-heading > span { display: none; }
    .party-members { max-width: 360px; width: 100%; margin: auto; gap: 24px; }
    .party-member { min-height: 224px; }
    .member-sprite { height: 122px; }
    .member-sprite :global(svg) { max-height: 116px; width: auto; }
    .member-name { margin-top: 12px; }
    .selection-hint { margin-top: 8px; }
    .stats-window { min-height: 285px; }
    .stats > div { grid-template-columns: 64px minmax(0, 1fr); gap: 10px; }
    .name-row dd { font-size: 25px; }
    .message-window { min-height: 0; }
    .quest-window { grid-template-columns: minmax(0, 1fr); gap: 8px; padding: 16px; }
    .secondary-commands { gap: 10px; }
    .secondary-commands summary { padding: 8px 16px; }
  }
  @media(prefers-reduced-motion: reduce) {
    .member-cursor, .member-sprite, .member-ground { transition: none; }
    [data-ready] [data-member-content]:not([hidden]) { animation: none; }
  }
</style>

