---
// トップページの最初にかぶせる「PRESS START」のタイトル画面。
// JSが動く環境でだけ表示し、クリック・キー入力・タップでホームへ明転する。
// JSが無ければ最初から非表示なので、ページを塞ぐことはない
import type { Locale } from "../i18n/config";
import { uiCopy } from "../i18n/ui";
import PixelChara from "./PixelChara.astro";
import PixelCloud from "./PixelCloud.astro";
import PixelGrass from "./PixelGrass.astro";

interface Props {
  locale: Locale;
  published: number;
  goal: number;
}

const { locale, published, goal } = Astro.props;
const copy = uiCopy[locale].home;
const siteName = uiCopy[locale].layout.siteName;
const percent = Math.min(100, (published / goal) * 100);
// 日本語・中国語は2行をそのままつなぎ、それ以外はスペースを挟む
const tagJoin = ["ja", "zh-cn", "zh-tw"].includes(locale) ? "" : " ";
---

<script is:inline>
  // 同じタブで一度開始したら、ホームへ戻ってもタイトル画面を挟まない。
  // 描画前に判定して、再訪時のちらつきも防ぐ。
  (() => {
    const root = document.documentElement;
    try {
      if (sessionStorage.getItem("akaoTitleStarted") !== "1") {
        root.dataset.titleScreen = "on";
        return;
      }
    } catch {
      // 記憶できない環境では、毎回の開始操作を求めずホームを表示する。
    }
    root.dataset.homeRevealed = "on";
  })();
</script>

<div
  class="title-screen"
  data-title-overlay
  role="button"
  tabindex="0"
  aria-label={copy.titleHint}
>
  <div class="title-frame">
    <PixelCloud class="cloud-a" width={120} style="top: 60px; left: 14%;" />
    <PixelCloud class="cloud-b" width={90} style="top: 140px; right: 12%;" />

    <div class="title-logo">
      <PixelChara size={104} animate />
      <p class="title-name">{siteName}</p>
      <p class="title-tagline">{copy.heroLines.join(tagJoin)}</p>
    </div>

    <div class="title-start">
      <p class="title-press">{copy.titleStart}</p>
      <p class="title-hint">{copy.titleHint}</p>
    </div>

    <div class="title-hud" aria-hidden="true">
      <span class="hud-lv">LV.{published}</span>
      <span class="hud-gauge"><span style={`width: ${percent}%`}></span></span>
      <span>{copy.hudCount(published, goal)}</span>
    </div>

    <div class="title-scene" aria-hidden="true">
      <PixelGrass size={34} delay="0.55s" class="grass-edge" />
      <svg
        width="96"
        height="102"
        viewBox="0 0 16 17"
        shape-rendering="crispEdges"
        xmlns="http://www.w3.org/2000/svg"
      >
        <rect x="0" y="0" width="16" height="14" fill="#16161c"></rect>
        <rect x="2" y="2" width="12" height="10" fill="#3f7d4b"></rect>
        <rect x="6" y="14" width="4" height="3" fill="#a9705f"></rect>
      </svg>
      <PixelGrass size={28} delay="0.2s" />
      <svg
        width="96"
        height="102"
        viewBox="0 0 16 17"
        shape-rendering="crispEdges"
        xmlns="http://www.w3.org/2000/svg"
      >
        <rect x="0" y="0" width="16" height="14" fill="#16161c"></rect>
        <rect x="2" y="2" width="12" height="10" fill="#3f7d4b"></rect>
        <rect x="6" y="14" width="4" height="3" fill="#a9705f"></rect>
      </svg>
      <PixelGrass size={34} delay="0.85s" class="grass-edge" />
    </div>
    <div class="title-edge"></div>
  </div>
  <p class="title-copy">© {new Date().getFullYear()} {siteName}</p>
</div>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const screen = document.querySelector("[data-title-overlay]");
    if (!screen) return;
    if (!root.dataset.titleScreen) {
      screen.remove();
      return;
    }

    let done = false;
    const reveal = () => {
      if (done) return;
      done = true;
      try {
        sessionStorage.setItem("akaoTitleStarted", "1");
      } catch {
        // 保存に失敗してもホームへの移動を妨げない。
      }
      window.akaoSfx?.play("start");
      root.dataset.titleScreen = "out";
      const finish = () => {
        delete root.dataset.titleScreen;
        screen.remove();
        // タイトルのせり上がりと会話ウィンドウの文字送りは、明転と同時に始める
        root.dataset.titleAnim = "on";
        root.dataset.homeRevealed = "on";
        document.dispatchEvent(new CustomEvent("akao:home-revealed"));
      };
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      setTimeout(finish, reduce ? 0 : 320);
    };

    screen.addEventListener("click", reveal);
    screen.addEventListener("touchstart", reveal, { passive: true });
    addEventListener("keydown", (event) => {
      if (done) return;
      // 修飾キー単体やTabでは始めない(キーボード操作を邪魔しないため)
      if (["Shift", "Control", "Alt", "Meta", "Tab"].includes(event.key)) return;
      if (event.key === " " || event.key === "Enter") event.preventDefault();
      reveal();
    });

    screen.focus({ preventScroll: true });
  })();
</script>
