---
// スマートフォンのピクセルアートSVG(16x16グリッド)。
// 小さく使うときは細部が潰れるので、24px未満では画面の描き込みを省く
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
const detailed = size >= 24;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 16 16"
  shape-rendering="crispEdges"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <rect x="3" y="0" width="10" height="16" fill="#16161c"></rect>
  <rect x="5" y="2" width="6" height="10" fill="#3be2f0"></rect>
  <rect x="7" y="13" width="2" height="1" fill="#fff8e8"></rect>
  {
    detailed && (
      <>
        <rect x="6" y="4" width="4" height="4" fill="#f7e08a" />
        <rect x="7" y="5" width="1" height="1" fill="#16161c" />
        <rect x="9" y="5" width="1" height="1" fill="#16161c" />
      </>
    )
  }
</svg>
