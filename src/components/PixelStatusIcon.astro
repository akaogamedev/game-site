---
interface Props { kind: 'gamepad' | 'speech' | 'idea' | 'question' | 'scroll' | 'flag' | 'phone' | 'browser' | 'play'; size?: number; }
const { kind, size = 32 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" shape-rendering="crispEdges" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
  {kind === 'flag' && <><path fill="#16161c" d="M4 2h3v2h14v11H7v7H4z"/><path fill="#e05c8a" d="M7 6h12v7H7z"/><path fill="#fff8e8" d="M7 6h4v3H7zm4 3h4v4h-4zm4-3h4v3h-4z"/></>}
  {kind === 'phone' && <><path fill="#16161c" d="M6 1h12v22H6z"/><path fill="#fff8e8" d="M8 3h8v18H8z"/><path fill="#35a3e0" d="M8 5h8v12H8z"/><path fill="#16161c" d="M11 19h2v1h-2z"/></>}
  {kind === 'browser' && <><path fill="#16161c" d="M1 3h22v18H1z"/><path fill="#fff8e8" d="M3 5h18v14H3z"/><path fill="#35a3e0" d="M3 5h18v4H3z"/><path fill="#16161c" d="M4 6h2v2H4zm4 0h2v2H8zm-5 3h18v2H3z"/></>}
  {kind === 'play' && <><path fill="#16161c" d="M5 2h4v2h3v2h3v2h3v2h3v4h-3v2h-3v2h-3v2H9v2H5z"/><path fill="#f7e08a" d="M7 5h2v2h3v2h3v2h3v2h-3v2h-3v2H9v2H7z"/></>}
  {kind === 'gamepad' && <>
    <path fill="#16161c" d="M5 5h14v2h2v3h1v10h-6v-3H8v3H2V10h1V7h2z"/>
    <path fill="#fff8e8" d="M5 8h14v3h1v7h-2v-3H6v3H4v-7h1z"/>
    <path fill="#35a3e0" d="M5 8h14v2H5z"/>
    <path fill="#16161c" d="M7 10h2v2h2v2H9v2H7v-2H5v-2h2z"/>
    <path fill="#e05c8a" d="M16 10h3v3h-3z"/><path fill="#2456a8" d="M13 13h3v3h-3z"/>
  </>}
  {(kind === 'speech' || kind === 'question') && <>
    <path fill="#16161c" d="M4 3h16v2h2v13h-9l-5 4H6v-4H2V5h2z"/>
    <path fill={kind === 'speech' ? '#fff8e8' : '#3be2f0'} d="M4 5h16v11H11l-3 3v-3H4z"/>
    {kind === 'speech' ? <path fill="#2456a8" d="M6 9h3v3H6zm5 0h3v3h-3zm5 0h2v3h-2z"/> : <path fill="#16161c" d="M9 6h6v2h2v3h-3v2h-3v-3h3V8h-3v1H8V7h1zm2 8h3v2h-3z"/>}
  </>}
  {kind === 'idea' && <>
    <path fill="#f7e08a" d="M11 0h2v3h-2zM1 8h3v2H1zm19 0h3v2h-3zM3 2h2v2H3zm16 0h2v2h-2z"/>
    <path fill="#16161c" d="M8 4h8v2h3v8h-3v4h-1v4H9v-4H8v-4H5V6h3z"/>
    <path fill="#f7e08a" d="M8 6h8v2h1v5h-3v4h-4v-4H7V8h1z"/>
    <path fill="#fff8e8" d="M9 7h3v2H9zm2 12h3v1h-3z"/>
  </>}
  {kind === 'scroll' && <>
    <path fill="#16161c" d="M5 2h15v2h2v6h-4v9h-2v3H3v-2H1v-6h4z"/>
    <path fill="#f7e08a" d="M7 4h11v2h2v2h-4v11h-3v1H5v-2H3v-2h4z"/>
    <path fill="#fff8e8" d="M8 4h8v2H8zM3 16h2v3H3z"/>
    <path fill="#b5854e" d="M9 8h5v2H9zm0 4h5v2H9zm0 4h3v2H9z"/>
  </>}
</svg>
