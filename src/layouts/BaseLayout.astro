---
import "../styles/global.css";
import { getCollection } from "astro:content";
import PixelChara from "../components/PixelChara.astro";
import PixelStatusIcon from '../components/PixelStatusIcon.astro';
import {
  defaultLocale,
  getLocalizedPath,
  localeCodes,
  localeMeta,
  type Locale,
} from "../i18n/config";
import { uiCopy } from "../i18n/ui";

interface Props {
  title?: string;
  description?: string;
  /** OGP用の画像(絶対URL、またはpublic/からのパス) */
  image?: string;
  locale?: Locale;
  stickyHeader?: boolean;
  /** 検索エンジン向けの構造化データ(schema.org)。@context は自動で付ける */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const xUrl = "https://x.com/akaogame0124";
// Cloudflareダッシュボード > Web Analytics でサイト登録後、発行されたトークンを設定する
// 空のままだと計測スクリプトは出力されない
const cfAnalyticsToken = "362b6cd98b3c466699db4f607779ffdc";
const {
  title,
  image = "/ogp.png",
  locale = defaultLocale,
  stickyHeader = true,
} = Astro.props;
const jsonLd = Astro.props.jsonLd && {
  "@context": "https://schema.org",
  "@graph": [Astro.props.jsonLd].flat(),
};

const copy = uiCopy[locale].layout;
const homeCopy = uiCopy[locale].home;
// ヘッダーHUDの進捗。100本企画にカウントするのは unityroomNo 付きのゲームだけ
const HUD_GOAL = 100;
const hudPublished = (await getCollection("games")).filter(
  (game) => game.data.unityroomNo,
).length;
const meta = localeMeta[locale];
const description = Astro.props.description ?? copy.description;
const siteName = copy.siteName;
const pageTitle = title ? `${title} | ${siteName}` : siteName;
const currentPath = Astro.url.pathname;
const shouldDetectLanguage =
  currentPath === "/" && locale === defaultLocale;
const absoluteUrl = (path: string) =>
  Astro.site ? new URL(path, Astro.site).href : undefined;
const canonicalUrl = absoluteUrl(currentPath);
const alternateLinks = localeCodes.map((targetLocale) => ({
  locale: targetLocale,
  label: localeMeta[targetLocale].label,
  hreflang: localeMeta[targetLocale].hreflang,
  href: getLocalizedPath(currentPath, targetLocale),
  absoluteHref: absoluteUrl(getLocalizedPath(currentPath, targetLocale)),
}));
const defaultUrl = absoluteUrl(
  getLocalizedPath(currentPath, defaultLocale),
);

// 相対パスの画像は site 設定(astro.config.mjs)があるときだけ絶対URL化できる
const ogImage = image
  ? image.startsWith("http")
    ? image
    : Astro.site
      ? new URL(image, Astro.site).href
      : undefined
  : undefined;
---

<!doctype html>
<html lang={meta.htmlLang} data-sound="off">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {
      alternateLinks.map(
        (link) =>
          link.absoluteHref && (
            <link
              rel="alternate"
              hreflang={link.hreflang}
              href={link.absoluteHref}
            />
          ),
      )
    }
    {defaultUrl && <link rel="alternate" hreflang="x-default" href={defaultUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={meta.ogLocale} />
    {
      localeCodes
        .filter((targetLocale) => targetLocale !== locale)
        .map((targetLocale) => (
          <meta
            property="og:locale:alternate"
            content={localeMeta[targetLocale].ogLocale}
          />
        ))
    }
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta
      name="twitter:card"
      content={ogImage ? "summary_large_image" : "summary"}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DotGothic16&family=Press+Start+2P&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // ページ遷移の暗転演出: 遷移元でフラグを立て、遷移先で黒から明転する
      (() => {
        try {
          if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
          if (sessionStorage.getItem("akaoPageFade")) {
            sessionStorage.removeItem("akaoPageFade");
            document.documentElement.dataset.pageFade = "in";
          }
        } catch {
          /* ストレージが使えない環境では演出なしで表示する */
        }
      })();
    </script>
    {
      shouldDetectLanguage && (
        <script is:inline>
          (() => {
            const supportedLocales = [
              "ja",
              "en",
              "zh-cn",
              "zh-tw",
              "ko",
              "es",
              "fr",
              "de",
              "pt-br",
            ];
            const savedValue = document.cookie
              .split("; ")
              .find((entry) => entry.startsWith("akao_language="))
              ?.split("=")[1];
            const savedLanguage = supportedLocales.includes(savedValue)
              ? savedValue
              : null;

            if (savedLanguage === "ja") return;
            if (
              savedLanguage !== "en" &&
              /bot|crawler|spider|crawling/i.test(navigator.userAgent)
            ) {
              return;
            }

            const detectLocale = (language) => {
              const normalized = language?.toLowerCase() ?? "";
              if (normalized.startsWith("zh")) {
                return /(?:hant|tw|hk|mo)/.test(normalized)
                  ? "zh-tw"
                  : "zh-cn";
              }
              if (normalized.startsWith("ko")) return "ko";
              if (normalized.startsWith("es")) return "es";
              if (normalized.startsWith("fr")) return "fr";
              if (normalized.startsWith("de")) return "de";
              if (normalized.startsWith("pt")) return "pt-br";
              if (normalized.startsWith("ja")) return "ja";
              return "en";
            };

            const targetLocale =
              savedLanguage ??
              detectLocale(navigator.languages?.[0] ?? navigator.language);

            if (targetLocale !== "ja") {
              window.location.replace(
                `/${targetLocale}/${window.location.search}${window.location.hash}`,
              );
            }
          })();
        </script>
      )
    }
    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}
        />
      )
    }
  </head>
  <body>
    <header class:list={["site-header", { "site-header-static": !stickyHeader }]}>
      <div class="container">
        <a class="site-logo" href={getLocalizedPath("/", locale)}>
          <PixelChara size={22} />
          {siteName}
        </a>
        <a
          class="hud"
          href={`${getLocalizedPath("/", locale)}#unityroom`}
          aria-label={`${homeCopy.progressLabel}: ${homeCopy.hudCount(hudPublished, HUD_GOAL)}`}
        >
          <span class="hud-lv" aria-hidden="true">LV.{hudPublished}</span>
          <span class="hud-gauge" aria-hidden="true"
            ><span style={`width: ${(hudPublished / HUD_GOAL) * 100}%`}></span></span
          >
          <span class="hud-count" aria-hidden="true">{homeCopy.hudCount(hudPublished, HUD_GOAL)}</span>
        </a>
        <nav class="site-nav">
          <a href={`${getLocalizedPath("/", locale)}#unityroom`}>
            <PixelStatusIcon kind="flag" size={24}/>{copy.unityroom}
          </a>
          <a href={`${getLocalizedPath("/", locale)}#ios`}><PixelStatusIcon kind="phone" size={24}/>{copy.ios}</a>
          <a href={getLocalizedPath("/about/", locale)}><PixelChara size={20}/>{copy.about}</a>
          <button
            type="button"
            class="sound-toggle"
            data-sound-toggle
            aria-label={copy.soundLabel}
            aria-pressed="false"
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 16 16"
              shape-rendering="crispEdges"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <rect x="1" y="6" width="3" height="4" fill="currentColor"></rect>
              <rect x="4" y="4" width="2" height="8" fill="currentColor"></rect>
              <rect x="6" y="2" width="2" height="12" fill="currentColor"></rect>
              <rect class="sound-wave" x="10" y="5" width="1" height="6" fill="currentColor"></rect>
              <rect class="sound-wave" x="12" y="3" width="1" height="10" fill="currentColor"></rect>
              <rect class="sound-off" x="9" y="4" width="1" height="1" fill="currentColor"></rect>
              <rect class="sound-off" x="10" y="5" width="1" height="1" fill="currentColor"></rect>
              <rect class="sound-off" x="11" y="6" width="1" height="1" fill="currentColor"></rect>
              <rect class="sound-off" x="12" y="7" width="1" height="1" fill="currentColor"></rect>
              <rect class="sound-off" x="13" y="8" width="1" height="1" fill="currentColor"></rect>
              <rect class="sound-off" x="13" y="4" width="1" height="1" fill="currentColor"></rect>
              <rect class="sound-off" x="12" y="5" width="1" height="1" fill="currentColor"></rect>
              <rect class="sound-off" x="11" y="6" width="1" height="1" fill="currentColor"></rect>
              <rect class="sound-off" x="10" y="7" width="1" height="1" fill="currentColor"></rect>
              <rect class="sound-off" x="9" y="8" width="1" height="1" fill="currentColor"></rect>
            </svg>
            <span class="sound-state" aria-hidden="true">OFF</span>
          </button>
          <label class="language-select">
            <span class="sr-only">{copy.languageLabel}</span>
            <select aria-label={copy.languageLabel} data-language-select>
              {
                alternateLinks.map((link) => (
                  <option
                    value={link.href}
                    data-language-code={link.locale}
                    selected={link.locale === locale}
                  >
                    {link.label}
                  </option>
                ))
              }
            </select>
          </label>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>
          {copy.updatesBefore}
          {" "}
          <a href={xUrl} target="_blank" rel="noopener">X (Twitter)</a>
          {copy.updatesAfter && ` ${copy.updatesAfter}`}
        </p>
        <p style="margin: 4px 0 12px;">
          <a href={getLocalizedPath("/privacy/", locale)}>{copy.privacy}</a>
        </p>
        © {new Date().getFullYear()} {siteName}
      </div>
    </footer>
    {
      cfAnalyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: cfAnalyticsToken })}
        />
      )
    }
    <div class="page-fade" aria-hidden="true"></div>
    <!-- ステージ突入のカットイン。カードをクリックしたときだけ走る -->
    <div class="stage-cutin" data-stage-cutin aria-hidden="true">
      <div class="cutin-band">
        <span class="cutin-text" data-cutin-text></span>
      </div>
    </div>
    <script is:inline>
      // クリア記録(訪れたゲームに CLEAR の判子)と、実績時の画面揺れ
      (() => {
        const KEY = "akaoCleared";
        const read = () => {
          try {
            return JSON.parse(localStorage.getItem(KEY) || "[]");
          } catch {
            return [];
          }
        };
        const page = document.querySelector("[data-game-slug]");
        if (page) {
          const set = new Set(read());
          set.add(page.dataset.gameSlug);
          try {
            localStorage.setItem(KEY, JSON.stringify([...set]));
          } catch {
            /* 記録できなければ判子が付かないだけ */
          }
        }
        const cleared = new Set(read());
        document.querySelectorAll(".game-card[data-slug]").forEach((card) => {
          if (cleared.has(card.dataset.slug)) card.classList.add("is-cleared");
        });

        window.akaoShake = () => {
          if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
          document.body.classList.remove("shake");
          void document.body.offsetWidth;
          document.body.classList.add("shake");
          setTimeout(() => document.body.classList.remove("shake"), 400);
        };
      })();
    </script>
    <script is:inline>
      // 8bit風の効果音。矩形波・三角波を短く鳴らすだけなので音声ファイルは持たない。
      // ブラウザの自動再生制限により、最初のクリックやキー入力があるまでは鳴らない
      (() => {
        const KEY = "akaoSound";
        const root = document.documentElement;
        let enabled = false;
        try {
          enabled = localStorage.getItem(KEY) === "on";
        } catch {
          /* ストレージが使えなければOFFで開始する */
        }
        root.dataset.sound = enabled ? "on" : "off";

        let ctx = null;
        let master = null;
        const ensure = () => {
          if (ctx) return ctx;
          const AC = window.AudioContext || window.webkitAudioContext;
          if (!AC) return null;
          ctx = new AC();
          master = ctx.createGain();
          master.gain.value = 0.12;
          master.connect(ctx.destination);
          return ctx;
        };

        // 1音: 波形・周波数・長さ・開始オフセット(秒)
        const tone = (type, freq, duration, at = 0, gain = 1, slideTo = null) => {
          const c = ensure();
          if (!c || c.state !== "running") return;
          const t0 = c.currentTime + at;
          const osc = c.createOscillator();
          const env = c.createGain();
          osc.type = type;
          osc.frequency.setValueAtTime(freq, t0);
          if (slideTo) osc.frequency.exponentialRampToValueAtTime(slideTo, t0 + duration);
          env.gain.setValueAtTime(gain, t0);
          env.gain.exponentialRampToValueAtTime(0.001, t0 + duration);
          osc.connect(env).connect(master);
          osc.start(t0);
          osc.stop(t0 + duration + 0.02);
        };

        const sounds = {
          // 文字送りのピッ
          blip: () => tone("square", 1760, 0.035, 0, 0.5),
          // カーソル移動
          move: () => tone("square", 660, 0.05, 0, 0.7),
          // 決定
          decide: () => { tone("square", 880, 0.06, 0, 0.8); tone("square", 1320, 0.09, 0.06, 0.8); },
          // タブ切替(市松ワイプに合わせて2段)
          tab: () => { tone("square", 523, 0.05, 0, 0.7); tone("square", 784, 0.07, 0.07, 0.7); },
          // ステージ開始(STAGE N のカットイン)
          start: () => [523, 659, 784, 1047].forEach((f, i) => tone("square", f, 0.12, i * 0.09, 0.8)),
          // じっせき かいじょ
          fanfare: () => { [784, 1047, 1319].forEach((f, i) => tone("triangle", f, 0.14, i * 0.1, 1)); tone("triangle", 1568, 0.45, 0.3, 1); },
        };

        const play = (name) => {
          if (root.dataset.sound !== "on") return;
          const fn = sounds[name];
          if (fn) fn();
        };
        window.akaoSfx = { play };

        // 音声ONのときだけ、操作に合わせて AudioContext を起こす
        const unlock = () => {
          if (root.dataset.sound !== "on") return;
          const c = ensure();
          if (c && c.state === "suspended") c.resume();
        };
        ["pointerdown", "keydown", "touchstart"].forEach((type) =>
          addEventListener(type, unlock, { passive: true }),
        );

        const toggle = document.querySelector("[data-sound-toggle]");
        const paint = () => {
          const on = root.dataset.sound === "on";
          toggle.setAttribute("aria-pressed", on ? "true" : "false");
          toggle.querySelector(".sound-state").textContent = on ? "ON" : "OFF";
        };
        paint();
        toggle.addEventListener("click", () => {
          const on = root.dataset.sound !== "on";
          root.dataset.sound = on ? "on" : "off";
          try {
            localStorage.setItem(KEY, on ? "on" : "off");
          } catch {
            /* 記録できなければこのページ内だけ */
          }
          paint();
          if (on) {
            unlock();
            play("decide");
          }
        });

        // 共通のUI音: ホバーで move、クリックで decide
        const hoverable = ".command, .tab, .game-card, .btn, .back-link, .site-nav a, .hud, .talk-skip";
        let lastHover = null;
        document.addEventListener("pointerover", (event) => {
          const el = event.target.closest(hoverable);
          if (!el || el === lastHover) return;
          lastHover = el;
          play("move");
        });
        document.addEventListener("pointerout", (event) => {
          if (event.target.closest(hoverable) === lastHover && !event.relatedTarget?.closest(hoverable)) lastHover = null;
        });
        document.addEventListener("click", (event) => {
          if (event.target.closest("[data-sound-toggle], [data-tab-btn], [data-talk], .talk-skip")) return;
          if (event.target.closest(hoverable)) play("decide");
        });
      })();
    </script>
    <script is:inline>
      // 内部リンクの遷移前に4段階の暗転を挟む(ゲームのシーン切り替え風)
      (() => {
        const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)");

        document.addEventListener("click", (event) => {
          if (reduceMotion.matches || event.defaultPrevented) return;
          if (
            event.button !== 0 ||
            event.metaKey ||
            event.ctrlKey ||
            event.shiftKey ||
            event.altKey
          ) {
            return;
          }
          const link = event.target.closest("a[href]");
          if (!link || link.target === "_blank" || link.hasAttribute("download")) {
            return;
          }
          const url = new URL(link.href, location.href);
          if (url.origin !== location.origin) return;
          // 同一ページ内のフラグメント移動には挟まない
          if (url.pathname === location.pathname && url.hash) return;

          event.preventDefault();
          try {
            sessionStorage.setItem("akaoPageFade", "1");
          } catch {
            /* フラグが立たなければ遷移先で明転しないだけ */
          }

          // ゲームカードからは「STAGE N」のカットインを挟んでから暗転する
          const card = link.closest(".game-card[data-stage]");
          const cutin = document.querySelector("[data-stage-cutin]");
          const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
          if (card && cutin && !reduce) {
            cutin.querySelector("[data-cutin-text]").textContent = "STAGE " + card.dataset.stage;
            cutin.classList.add("run");
            window.akaoSfx?.play("start");
            setTimeout(() => (document.documentElement.dataset.pageFade = "out"), 700);
            setTimeout(() => location.assign(url.href), 900);
            return;
          }
          document.documentElement.dataset.pageFade = "out";
          setTimeout(() => location.assign(url.href), 200);
        });

        // 戻るボタンでbfcacheから復帰したときに黒画面を残さない
        addEventListener("pageshow", (event) => {
          if (event.persisted) {
            delete document.documentElement.dataset.pageFade;
            document.querySelector("[data-stage-cutin]")?.classList.remove("run");
          }
        });
      })();
    </script>
    <script is:inline>
      document
        .querySelector("[data-language-select]")
        ?.addEventListener("change", (event) => {
          const selectedOption = event.currentTarget.selectedOptions[0];
          const language = selectedOption.dataset.languageCode;
          document.cookie = `akao_language=${language}; Path=/; Max-Age=31536000; SameSite=Lax`;
          window.location.assign(event.currentTarget.value);
        });
    </script>
  </body>
</html>
